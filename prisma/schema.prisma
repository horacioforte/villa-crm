model DecisorDossie {
  id        String  @id @default(cuid())
  nome      String
  cargo     String?
  empresa   String?  // empresa onde trabalha â€” pode nÃ£o estar no CRM ainda
  telefone  String?
  email     String?
  linkedin  String?
  confianca Int     @default(50)  // 0â€“100 â€” confianÃ§a na informaÃ§Ã£o
  fonte     String?
