  @@index([dossieId])
  @@index([empresaId])
  @@index([papel])
}

// â”€â”€ AtualizacaoDossie â€” log de tudo que o JoÃ£o descobriu â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

