// ─────────────────────────────────────────────
// PROSPECÇÃO ATIVA (João outbound) — nunca remover, só acrescentar
// Regra: disparo NÃO cria oportunidade. Só sinal real de interesse cria.
// ─────────────────────────────────────────────

enum StatusProspect {
  PROSPECTADO       // na lista/radar, ainda não abordado
  ABORDADO          // primeiro contato enviado (WhatsApp/e-mail disparado)
  RESPONDEU         // qualquer resposta recebida
  INTERESSADO       // sinal positivo claro de interesse
  QUALIFICADO       // qualificado pelo comercial ou pelo agente
  OPORTUNIDADE_CRIADA // oportunidade criada no CRM
  DESCARTADO        // sem interesse ou fora do perfil
}

enum TipoInteracaoProspect {
  WHATSAPP_ENVIADO
  WHATSAPP_ENTREGUE
  WHATSAPP_LIDO
  WHATSAPP_RESPONDIDO
  EMAIL_ENVIADO
  EMAIL_ENTREGUE
  EMAIL_ABERTO
  EMAIL_CLICADO
  EMAIL_RESPONDIDO
  LIGACAO_REALIZADA
  INTERESSE_REGISTRADO  // sinal positivo detectado pela IA ou marcado manualmente
  QUALIFICADO_MANUAL    // comercial marcou como qualificado
  DESCARTADO
}

model Campanha {
  id               String   @id @default(cuid())
  nome             String
  descricao        String?  @db.Text
  mensagemInicial  String?  @db.Text  // texto enviado na primeira abordagem ativa do João
  agente           String   @default("joao-villa")  // "joao-villa" | "maria-villa" etc.
  tipo             String   @default("WHATSAPP")     // "WHATSAPP" | "EMAIL" | "MISTO"
  status           String   @default("ATIVA")        // "RASCUNHO" | "ATIVA" | "PAUSADA" | "CONCLUIDA"

  prospects   Prospect[]

  createdById String?
  createdBy   Usuario? @relation("CampanhaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agente])
  @@index([status])
  @@index([createdById])
}

model Prospect {
  id            String         @id @default(cuid())
  status        StatusProspect @default(PROSPECTADO)
  agente        String         @default("joao-villa")

  // Origem do prospect
  origem        String?        // "radar_obras" | "cnae" | "econodata" | "planilha" | "campanha_usados" | "manual"
  origemDetalhe String?        // ex: "CNAE 41204" ou "Econodata - SP - Construtoras"

  // Dados de contato brutos (antes de ter empresa/pessoa no CRM)
  nomeContato   String?
  telefone      String?
  email         String?

  // Vínculo com CRM (opcional)
  empresaId     String?
  empresa       Empresa?     @relation("ProspectEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)

  pessoaId      String?
  pessoa        Pessoa?      @relation("ProspectPessoa", fields: [pessoaId], references: [id], onDelete: SetNull)

  // Campanha (opcional)
  campanhaId    String?
  campanha      Campanha?    @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  // Quando converteu em oportunidade
  oportunidadeId String?
  oportunidade   Oportunidade? @relation("ProspectOportunidade", fields: [oportunidadeId], references: [id], onDelete: SetNull)

  interacoes    ProspectInteracao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([agente])
  @@index([empresaId])
  @@index([pessoaId])
  @@index([campanhaId])
  @@index([telefone])
}

model ProspectInteracao {
  id          String                @id @default(cuid())
  tipo        TipoInteracaoProspect
  canal       String                // "WHATSAPP" | "EMAIL" | "LIGACAO"
  conteudo    String?               @db.Text
  instancia   String?               // "joao-villa"
  waMessageId String?
  criadoPorIA Boolean               @default(true)
  observacao  String?               @db.Text

  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([prospectId])
  @@index([tipo])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// CENTRAL DE ATENDIMENTO — nunca remover, só acrescentar
// ─────────────────────────────────────────────

enum CanalAtendimento {
  WHATSAPP
  EMAIL
  TELEFONE
  CHAT
}

enum StatusConversa {
  ABERTA
  PENDENTE
  CONCLUIDA
  SPAM
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum AutorMensagem {
  IA
  HUMANO
  SISTEMA
  CLIENTE
}

enum StatusMensagem {
  ENVIADA
  ENTREGUE
  LIDA
  ERRO
  PENDENTE
  RECEBIDA
}

// ─────────────────────────────────────────────
// CANAIS WHATSAPP (Fase 2 — Central de Atendimento) — nunca remover, só acrescentar
// ─────────────────────────────────────────────

// Estado persistente de processamento (Etapa 3 — fecha o risco de mensagem recebida
// e abandonada por interrupção do processamento síncrono, sem depender de heurística).
enum ProcessamentoMensagemStatus {
  NAO_APLICAVEL       // mensagens de saída, ou entrada em canal sem agente de IA
  PENDENTE            // entrada recebida, aguardando início do processamento
  PROCESSANDO         // processamento em andamento — adquirido atomicamente
  PROCESSADA          // IA concluída + envio aceito pela Meta + CRM atualizado
  ERRO_PROCESSAMENTO  // qualquer falha em qualquer etapa do processamento
}

enum CanalWhatsappTipo {
  META_CLOUD_API
  EVOLUTION
  CHATWOOT_MIRROR
}

model CanalWhatsapp {
  id                  String            @id @default(cuid())
  nome                String
  tipo                CanalWhatsappTipo
  instanceName        String            @unique
  phoneNumberId       String?           @unique
  businessAccountId   String?
  displayPhoneNumber  String?

  // Nomes de variaveis de ambiente (nunca o segredo em si) — resolvidos
  // apenas via allowlist fixa em lib/whatsapp/env-allowlist.ts
  accessTokenEnvVar   String?
  verifyTokenEnvVar   String?
  appSecretEnvVar     String?           // App Secret da Meta — usado so para validar X-Hub-Signature-256

  ativo               Boolean           @default(true)
  responsavelPadraoId String?
  responsavelPadrao   Usuario?          @relation(fields: [responsavelPadraoId], references: [id], onDelete: SetNull)
  agenteIA            String?

  ultimoWebhookEm     DateTime?
  ultimoErro          String?           @db.Text

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  conversas Conversa[] @relation("ConversaCanal")
  mensagens Mensagem[] @relation("MensagemCanal")

  @@index([ativo])
}

model Conversa {
  id             String           @id @default(cuid())
  canal          CanalAtendimento @default(WHATSAPP)
  status         StatusConversa   @default(ABERTA)
  instanceName   String           // maria-villa, joao-villa, morgana-villa, taciane-villa
  chatwootId     Int?
  telefone       String?          // número do contato no WhatsApp
  nomeContato    String?

  // Vínculo opcional com CRM
  empresaId      String?
  empresa        Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  pessoaId       String?
  pessoa         Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)

  // Atendente responsável (humano)
  atendidoPorId  String?
  atendidoPor    Usuario? @relation("ConversaAtendente", fields: [atendidoPorId], references: [id], onDelete: SetNull)

  // Fase 2 — canal WhatsApp de origem/atual da conversa
  // onDelete Restrict: canal usado nunca pode ser apagado, só desativado (ativo=false)
  canalWhatsappId        String?
  canalWhatsapp          CanalWhatsapp? @relation("ConversaCanal", fields: [canalWhatsappId], references: [id], onDelete: Restrict)

  // Fase 2 — tarefa que hoje referencia/exibe esta conversa (não é dono do histórico)
  tarefaAtualId          String?
  tarefaAtual            Tarefa? @relation("ConversaTarefaAtual", fields: [tarefaAtualId], references: [id], onDelete: SetNull)

  iaPausada              Boolean  @default(false)
  atendimentoHumanoAtivo Boolean  @default(false)

  ultimaMensagemEm DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mensagens     Mensagem[]
  transferencias ConversaTransferencia[]

  @@index([status])
  @@index([instanceName])
  @@index([empresaId])
  @@index([pessoaId])
  @@index([oportunidadeId])
  @@index([atendidoPorId])
  @@index([ultimaMensagemEm])
  @@index([canalWhatsappId])
  @@index([tarefaAtualId])
}

model Mensagem {
  id           String          @id @default(cuid())
  conteudo     String          @db.Text
  direcao      DirecaoMensagem
  autor        AutorMensagem   @default(IA)
  status       StatusMensagem  @default(ENVIADA)
  waMessageId  String?         // ID retornado pela Evolution API — legado, mantido por compatibilidade
  mimeType     String?         // para arquivos/áudio
  mediaUrl     String?

  conversaId   String
  conversa     Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  // Quem enviou (se humano)
  autorUsuarioId String?
  autorUsuario   Usuario? @relation("MensagemAutor", fields: [autorUsuarioId], references: [id], onDelete: SetNull)

  // Fase 2 — idempotência e auditoria
  // onDelete Restrict: evita SetNull deixar externalMessageId orfao (conflitaria com o CHECK
  // mensagem_external_id_requer_canal); canal usado nunca e apagado, so desativado
  canalWhatsappId   String?
  canalWhatsapp     CanalWhatsapp? @relation("MensagemCanal", fields: [canalWhatsappId], references: [id], onDelete: Restrict)
  externalMessageId String?        // ID do provedor (wamid.* na Meta) — unicidade é composta com canalWhatsappId, ver @@unique abaixo
  messageType       String?        // text|image|audio|video|document|location|contact|template|interactive|unsupported
  replyToMensagemId String?
  replyTo           Mensagem?  @relation("MensagemReply", fields: [replyToMensagemId], references: [id], onDelete: SetNull)
  replies           Mensagem[] @relation("MensagemReply")
  errorCode         String?
  errorMessage      String?    @db.Text
  rawPayload        Json?
  deliveredAt       DateTime?
  readAt            DateTime?
  receivedAt        DateTime?

  // Estado persistente de processamento (Etapa 3)
  processamentoStatus       ProcessamentoMensagemStatus @default(NAO_APLICAVEL)
  processamentoErroCodigo   String?
  processamentoErro         String?   @db.Text
  processamentoTentativas   Int       @default(0)
  processamentoAtualizadoEm DateTime?
  processadaEm              DateTime?

  createdAt DateTime @default(now())

  @@index([conversaId])
  @@index([conversaId, createdAt])
  @@index([autorUsuarioId])
  @@index([waMessageId])
  @@index([canalWhatsappId])
  @@index([externalMessageId])
  @@index([replyToMensagemId])
  @@index([processamentoStatus, processamentoAtualizadoEm])
  @@unique([canalWhatsappId, externalMessageId])
}

// Histórico de transferências de conversa entre atendentes
model ConversaTransferencia {
  id           String   @id @default(cuid())

  conversaId   String
  conversa     Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  // De quem saiu
  deUsuarioId  String?
  deUsuario    Usuario? @relation("TransferenciaOrigem", fields: [deUsuarioId], references: [id], onDelete: SetNull)

  // Para quem foi
  paraUsuarioId String?
  paraUsuario   Usuario? @relation("TransferenciaDestino", fields: [paraUsuarioId], references: [id], onDelete: SetNull)

  // Quem fez a transferência (pode ser diferente do "de")
  feitoPorId   String?
  feitoPor     Usuario? @relation("TransferenciaExecutor", fields: [feitoPorId], references: [id], onDelete: SetNull)

  motivo       String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([conversaId])
  @@index([deUsuarioId])
  @@index([paraUsuarioId])
  @@index([feitoPorId])
}

model TemplateResposta {
  id          String   @id @default(cuid())
  nome        String
  conteudo    String   @db.Text
  categoria   String?
  ativo       Boolean  @default(true)

  criadoPorId String?
  criadoPor   Usuario? @relation("TemplateRespostaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([criadoPorId])
  @@index([ativo])
}

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?
  ip        String?
  userAgent String?

  userId String?
  user   Usuario? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CENTRAL DE INTELIGÊNCIA COMERCIAL — nunca remover, só acrescentar
// João Hunter IA: investigador permanente de dossiês comerciais.
// ─────────────────────────────────────────────────────────────────────────────

enum OrigemDossie {
  JOAO_RADAR       // radar semanal de obras/infraestrutura
  JOAO_OUTBOUND    // prospecção ativa via WhatsApp
  MANUAL           // inserção manual pela equipe
}

enum TipoDossie {
  OBRA
  EMPRESA
  MOVIMENTO_ESTRATEGICO
  LICENCIAMENTO
  LEAD
}

enum StatusDossie {
  INVESTIGANDO           // João pesquisando ativamente
  AGUARDANDO_VALIDACAO   // João acredita que está maduro — aguarda Morgana
  EM_ANALISE             // Morgana está analisando
  PEDIR_MAIS_PESQUISA    // Morgana pediu aprofundamento
  PRONTO_PARA_ASSUMIR    // Morgana aprovou
  ASSUMIDO               // virou oportunidade no pipeline comercial
  ARQUIVADO              // descartado ou inativo
}

enum TipoAtualizacaoDossie {
  CRIACAO
  CAMPO_ATUALIZADO
  DECISOR_ENCONTRADO
  EMPRESA_ENCONTRADA
  NOTICIA_ENCONTRADA
  MISSAO_CONCLUIDA
  MISSAO_DEFINIDA
  SOLICITACAO_PESQUISA    // Morgana pediu mais pesquisa
  ANALISE_MORGANA
  ASSUMIDO_PELO_COMERCIAL
  MONITORAMENTO           // João continua monitorando após assunção
}

// ── DossieComercial ──────────────────────────────────────────────────────────

model DossieComercial {
  id     String @id @default(cuid())

  // ── Identificação ──
  titulo  String
  resumo  String?  @db.Text
  origem  OrigemDossie
  tipo    TipoDossie    @default(OBRA)
  status  StatusDossie  @default(INVESTIGANDO)
  segmento String?

  // ── Localização ──
  cidade  String?
  estado  String?

  // ── Obra / Projeto ──
  clienteFinal   String?
  construtora    String?
  epc            String?
  epcm           String?
  consorcio      String?
  faseObra       String?
  cronograma     String?  @db.Text
  licenciamento  String?  @db.Text
  valorEstimado  Decimal? @db.Decimal(15, 2)
  volumeConcreto Decimal? @db.Decimal(12, 2)

  // ── Inteligência Comercial ──
  equipamentosSugeridos String?  @db.Text
  campanhasSugerida     String?
  proximaAcaoSugerida   String?
  concorrentes          String?  @db.Text
  fornecedores          String?  @db.Text
  concreteiras          String?  @db.Text

  // ── Fonte ──
  fonteInformacao String?
  linkFonte       String?

  // ── Score e Completude ──
  score                Int     @default(0)   // 0–100 — qualidade da oportunidade
  completude           Int     @default(0)   // 0–100 — % de campos preenchidos (quanto João conhece da obra)
  maturidadeComercial  Int     @default(0)   // 0–100 — o quanto faz sentido a Villa agir comercialmente
  prioridade           String? // "ALTA" | "MEDIA" | "BAIXA"

  // ── Missão João ──
  missaoAtual String?  // ex: "Descobrir o telefone do Diretor de Obras"

  // ── Contadores cacheados (atualizados a cada enriquecimento) ──
  totalDecisores    Int @default(0)
  totalEmpresas     Int @default(0)
  totalNoticias     Int @default(0)
  totalAtualizacoes Int @default(0)

  // ── Vínculo CRM — apcionais ──
  empresaId String?
  empresa   Empresa? @relation("DossieEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)

  obraId String?
  obra   Obra?   @relation("DossieObra", fields: [obraId], references: [id], onDelete: SetNull)

  // Preenchido quando Morgana assume — aponta para a oportunidade criada no pipeline
  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)

  // ── Assunção ──
  assumidoPorId String?
  assumidoPor   Usuario?  @relation("DossieAssumidoPor", fields: [assumidoPorId], references: [id], onDelete: SetNull)
  assumidaEm    DateTime?

  // ── Motivo de descarte (quando ARQUIVADO) ──
  motivoDescarte String? @db.Text

  // ── Audit ──
  criadoPorAgente  String   @default("joao-radar")
  ultimaAtividade  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relações ──
  atualizacoes         AtualizacaoDossie[]
  decisores            DecisorDossie[]
  empresasRelacionadas EmpresaDossie[]

  @@index([status])
  @@index([estado])
  @@index([segmento])
  @@index([score])
  @@index([completude])
  @@index([maturidadeComercial])
  @@index([origem])
  @@index([empresaId])
  @@index([obraId])
  @@index([oportunidadeId])
  @@index([createdAt])
  @@index([ultimaAtividade])
}

// ── DecisorDossie — decisores encontrados pelo João ──────────────────────────

model DecisorDossie {
  id        String  @id @default(cuid())
  nome      String
  cargo     String?
  empresa   String?  // empresa onde trabalha — pode não estar no CRM ainda
  telefone  String?
  email     String?
  linkedin  String?
  confianca Int     @default(50)  // 0–100 — confiança na informação
  fonte     String?
  ativo     Boolean @default(true)

  dossieId String
  dossie   DossieComercial @relation(fields: [dossieId], references: [id], onDelete: Cascade)

  // Link com CRM se encontrado
  pessoaId String?
  pessoa   Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossieId])
  @@index([pessoaId])
  @@index([nome])
}

// ── EmpresaDossie — empresas relacionadas encontradas pelo João ───────────────

model EmpresaDossie {
  id          String  @id @default(cuid())
  razaoSocial String
  // papel: CONSTRUTORA | EPC | EPCM | CONSORCIO | FORNECEDOR | CONCORRENTE | CONCRETEIRA | CLIENTE_FINAL
  papel       String
  cidade      String?
  estado      String?
  cnpj        String?
  site        String?
  fonte       String?
  ativo       Boolean @default(true)

  dossieId String
  dossie   DossieComercial @relation(fields: [dossieId], references: [id], onDelete: Cascade)

  // Link com CRM se já existir cadastro
  empresaId String?
  empresa   Empresa? @relation("EmpresaDossieEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossieId])
  @@index([empresaId])
  @@index([papel])
}

// ── AtualizacaoDossie — log de tudo que o João descobriu ─────────────────────

model AtualizacaoDossie {
  id       String                @id @default(cuid())
  tipo     TipoAtualizacaoDossie
  titulo   String
  conteudo String                @db.Text
  fonte    String?
  link     String?
  agente   String?               // "joao-radar" | "joao-outbound" | "morgana" | "comercial"

  dossieId String
  dossie   DossieComercial @relation(fields: [dossieId], references: [id], onDelete: Cascade)

  // Também vinculada à oportunidade quando o dossiê já foi assumido
  oportunidadeId String?

  // Se foi ação humana (Morgana, comercial)
  usuarioId String?

  createdAt DateTime @default(now())

  @@index([dossieId])
  @@index([tipo])
  @@index([oportunidadeId])
 @@index([createdAt])
}

/// Oportunidades do Radar João aguardando aprovação da Morgana via WhatsApp A/B.
/// Criado em /api/agent/route.ts ao enviar o WhatsApp. Processado em lib/whatsapp/agentes/joao.ts.
/// REGRA: nunca remover este modelo.
model RadarPendingOportunidade {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?  @db.Text
  temperatura String?
  potencial   Decimal? @db.Decimal(18, 2)
  tipoServico String?
  origem      String

  /// IDs armazenados sem FK explícita — modelos existentes não são alterados (regra: nunca remover)
  empresaId String
  obraId    String
  pessoaId  String?

  /// AGUARDANDO | APROVADA | DESCARTADA
  status    String   @default("AGUARDANDO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
